# /assets/* immutable 一年（2026-09-10 性能批次）：JS/CSS 由 functions/[[path]].js 在 HTML 里注入
# ?v=部署commit 指纹，内容一变引用即变，长缓存才安全；该类路由已被 _routes.json 排除在函数外，
# 这条头由静态服务直接应用。改 JS/CSS 后无需任何清缓存动作，新 HTML 引用新 URL
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/music/*
  Cache-Control: public, max-age=86400

/video/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=86400

# PWA（2026-09-09 批次）：SW 文件必须即时更新（默认长缓存会让装上的版本卡死在旧代码）；
# manifest 防止被当成默认 octet-stream（安装时识别不了）
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
